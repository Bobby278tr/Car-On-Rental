            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NetPrice</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaNetPrice</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SecurityDeposite</assignToReference>
            <operator>Assign</operator>
            <value>
