    <decisions>
        <name>Check_Coupon_Code_Validity</name>
        <label>Check Coupon Code Validity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Coupon_Code_Not_Valid_Flag</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, It&apos;s Not</defaultConnectorLabel>
        <rules>
            <name>Yes_It_s_Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Coupon_Code</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_System_Threshold</targetReference>
            </connector>
            <label>Yes, It&apos;s Valid</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Coupon_Code_Entered</name>
        <label>Is Coupon Code Entered ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_System_Threshold</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, Not Entered</defaultConnectorLabel>
        <rules>
            <name>Yes_Coupon_Code_Entered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Enter_Coupon_Code</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Coupon_Code</targetReference>
            </connector>
            <label>Yes, Coupon Code Entered</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>formulaBookingPrice</name>
        <dataType>Currency</dataType>
        <expression>{!BookingDays} * {!Get_Car_Details.Rental_Rate_Per_Day__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formulaNetPrice</name>
        <dataType>Currency</dataType>
        <expression>IF(NOT(ISBLANK({!Enter_Coupon_Code})),
 {!BookingPrice} - (({!Get_Coupon_Code.Discount_Percentage__c}/100)* {!BookingPrice}), 
{!BookingPrice})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formulaSecurityDeposite</name>
        <dataType>Currency</dataType>
        <expression>VALUE({!Get_System_Threshold.Value__c})/100 * {!NetPrice}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>noOfBookingDays</name>
        <dataType>Number</dataType>
        <expression>IF({!End_Date_Of_Booking} == {!Start_Date_Of_Booking}, 1, {!End_Date_Of_Booking} - {!Start_Date_Of_Booking})</expression>
        <scale>0</scale>
    </formulas>
